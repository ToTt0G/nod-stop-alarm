    <!-- Onboarding -->
    <string name="onb1_title">Nod off.\nWe\'ll nudge you.</string>
    <string name="onb1_text">Set your stop, then relax. Nod wakes you right before you arrive — on trains, buses, trams and ferries.</string>
    <string name="onb2_title">Draw your zone</string>
    <string name="onb2_text">Pick a station or drop a pin, then stretch the circle. The moment you enter it, your phone wakes you.</string>
    <string name="onb3_title">Alarm, buzz or both</string>
    <string name="onb3_text">A rising alarm for deep sleepers, a gentle buzz for the quiet carriage. Your call, every trip.</string>
    <string name="onb4_title">Almost ready</string>
    <string name="onb4_text">Nod works fully on your phone. Your location is never uploaded or stored anywhere else.</string>
