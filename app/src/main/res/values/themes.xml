<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nod" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/nod_paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Nod.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nod_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Nod</item>
    </style>
    <style name="Theme.Nod.Alarm" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nod_ink</item>
    </style>
</resources>
